{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "float-launcher",
  "version": "0.1.0",
  "identifier": "com.floatlauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "launcher",
        "title": "软件面板",
        "url": "index.html?panel=launcher",
        "width": 480,
        "height": 900,
        "x": -600,
        "y": 15,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "files",
        "title": "文件面板",
        "url": "index.html?panel=files",
        "width": 400,
        "height": 900,
        "x": 2000,
        "y": 15,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "settings.html",
        "width": 400,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/float-launcher/**",
          "$APPDATA/float-launcher/**",
          "$HOME/AppData/Roaming/float-launcher/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}